# ==============================
# amoCRM
# ==============================

AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://localhost

# Optional bootstrap values. Prefer data/tokens.json after oauth_setup.py
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# ==============================
# Application
# ==============================

APP_TIMEZONE=Europe/Moscow
DEFAULT_STALE_DAYS=2
DEFAULT_PIPELINE_ID=

# ==============================
# Optional custom fields
# ==============================

AMOCRM_LOST_REASON_FIELD_ID=

# ==============================
# MCP
# ==============================

MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp

# Optional MCP client protection (OAuth 2.1 resource server).
# amoCRM OAuth does NOT protect /mcp. Leave empty for local 127.0.0.1 tests.
MCP_AUTH_TOKEN=
MCP_AUTH_ISSUER_URL=
MCP_PUBLIC_URL=
MCP_ALLOWED_HOSTS=
MCP_DISABLE_DNS_REBINDING_PROTECTION=false

# ==============================
# Logging
# ==============================

LOG_LEVEL=INFO
