# ==============================
# amoCRM (MCP → amoCRM API)
# ==============================

AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://localhost

# Optional bootstrap values. Prefer data/tokens.json after oauth_setup.py
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# ==============================
# Application
# ==============================

APP_TIMEZONE=Europe/Moscow
DEFAULT_STALE_DAYS=2
DEFAULT_PIPELINE_ID=

# ==============================
# Optional custom fields
# ==============================

AMOCRM_LOST_REASON_FIELD_ID=

# ==============================
# MCP HTTP
# ==============================

MCP_HOST=127.0.0.1
# Localhost only. WB MCP uses 8788 — do not reuse that port.
MCP_PORT=8000
MCP_PATH=/mcp

# Публичный HTTPS-адрес БЕЗ /mcp. Нужен ChatGPT и OAuth metadata.
MCP_PUBLIC_URL=

# ==============================
# ChatGPT → MCP OAuth (Authorization Code + PKCE)
# Client Secret не нужен: публичный клиент + PKCE S256.
# Это НЕ токен amoCRM. Пароль страницы /authorize храните как bcrypt-хеш.
# ==============================

OAUTH_ISSUER=
OAUTH_CLIENT_ID=chatgpt-amocrm-mcp
# Точный Callback URL из настроек MCP connector в ChatGPT. Несколько — через запятую.
OAUTH_REDIRECT_URI=
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_AUTH_CODE_TTL=300
MCP_LOGIN=
MCP_PASSWORD_HASH=

# Optional static bearer for curl/debug. ChatGPT его не использует, если включён OAuth выше.
MCP_AUTH_TOKEN=
MCP_AUTH_ISSUER_URL=
MCP_ALLOWED_HOSTS=
MCP_DISABLE_DNS_REBINDING_PROTECTION=false

# ==============================
# Logging
# ==============================

LOG_LEVEL=INFO
